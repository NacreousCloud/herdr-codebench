{
  "id": "root",
  "type": "column",
  "background": "canvas",
  "titlebar": "none",
  "traffic_lights": [
    12,
    13
  ],
  "theme": "idea",
  "terminal_padding": [
    10,
    8
  ],
  "terminal_menu": "codenav",
  "preview": "layouts/idea.svg",
  "children": [
    {
      "id": "main-toolbar",
      "type": "block",
      "size": {
        "px": 40
      },
      "window_drag": true,
      "content": {
        "mod": "codenav",
        "props": {
          "view": "toolbar"
        }
      },
      "background": "canvas"
    },
    {
      "id": "body",
      "type": "row",
      "children": [
        {
          "id": "stripe",
          "type": "block",
          "size": {
            "px": 40
          },
          "content": {
            "mod": "codenav",
            "props": {
              "view": "stripe",
              "side": "left"
            }
          },
          "min": 40,
          "max": 40,
          "background": "canvas"
        },
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 300
          },
          "min": 120,
          "background": "surface",
          "children": [
            {
              "id": "left-bar",
              "type": "block",
              "size": {
                "px": 32
              },
              "content": {
                "mod": "codenav",
                "props": {
                  "view": "toolheader",
                  "side": "left"
                }
              },
              "radius": 10
            },
            {
              "id": "sidebar-views",
              "type": "stack",
              "active": "view-files",
              "children": [
                {
                  "id": "view-files",
                  "type": "block",
                  "content": {
                    "mod": "activity",
                    "props": {
                      "view": "files"
                    }
                  },
                  "radius": 10
                },
                {
                  "id": "view-review",
                  "type": "block",
                  "content": {
                    "mod": "codenav",
                    "props": {
                      "view": "review",
                      "part": "side"
                    }
                  },
                  "radius": 10
                },
                {
                  "id": "view-structure",
                  "type": "block",
                  "content": {
                    "mod": "codenav",
                    "props": {
                      "view": "structure"
                    }
                  },
                  "radius": 10
                },
                {
                  "id": "view-search",
                  "type": "block",
                  "content": {
                    "mod": "activity",
                    "props": {
                      "view": "search"
                    }
                  },
                  "radius": 10
                },
                {
                  "id": "left-empty",
                  "type": "block",
                  "content": {
                    "mod": "codenav",
                    "props": {
                      "view": "toolempty",
                      "side": "left"
                    }
                  },
                  "radius": 10
                }
              ]
            },
            {
              "id": "island-left-bottom",
              "type": "block",
              "size": {
                "px": 10
              },
              "min": 10,
              "max": 10,
              "background": "canvas",
              "content": {
                "mod": "codenav",
                "props": {
                  "view": "islandbottom"
                }
              }
            }
          ],
          "radius": 10
        },
        {
          "id": "work-body",
          "type": "column",
          "children": [
            {
              "id": "editor-area",
              "type": "column",
              "children": [
                {
                  "id": "editor-tabs",
                  "type": "block",
                  "content": {
                    "mod": "codenav",
                    "props": {
                      "view": "tabs"
                    }
                  },
                  "size": {
                    "px": 38
                  },
                  "radius": 10
                },
                {
                  "id": "editor-stack",
                  "type": "stack",
                  "children": [
                    {
                      "id": "editor-code",
                      "type": "block",
                      "content": {
                        "mod": "codenav",
                        "props": {
                          "view": "code",
                          "slot": true
                        }
                      },
                      "radius": 10
                    },
                    {
                      "id": "editor-text",
                      "type": "block",
                      "content": {
                        "mod": "activity",
                        "props": {
                          "view": "editor",
                          "slot": true
                        }
                      },
                      "radius": 10
                    },
                    {
                      "id": "editor-review",
                      "type": "block",
                      "content": {
                        "mod": "codenav",
                        "props": {
                          "view": "review",
                          "part": "main"
                        }
                      },
                      "radius": 10
                    }
                  ],
                  "active": "editor-code"
                }
              ],
              "size": {
                "weight": 3
              },
              "min": 30,
              "background": "surface",
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 10
            },
            {
              "id": "terminal-panel",
              "type": "column",
              "size": {
                "weight": 2
              },
              "children": [
                {
                  "id": "bottom-bar",
                  "type": "block",
                  "size": {
                    "px": 32
                  },
                  "content": {
                    "mod": "codenav",
                    "props": {
                      "view": "toolheader",
                      "side": "bottom"
                    }
                  },
                  "radius": 10
                },
                {
                  "id": "bottom-stack",
                  "type": "stack",
                  "active": "bottom-terminal",
                  "children": [
                    {
                      "id": "bottom-terminal",
                      "type": "block",
                      "content": {
                        "tab": "active",
                        "pane": {
                          "background": "surface",
                          "border": {
                            "width": 0,
                            "color": "surface"
                          },
                          "focus": {
                            "width": 0,
                            "color": "surface"
                          },
                          "radius": 10,
                          "gap": 6
                        }
                      },
                      "radius": 10
                    },
                    {
                      "id": "bottom-problems",
                      "type": "block",
                      "content": {
                        "mod": "codenav",
                        "props": {
                          "view": "problems"
                        }
                      },
                      "radius": 10
                    },
                    {
                      "id": "bottom-agents",
                      "type": "block",
                      "content": {
                        "mod": "agents"
                      },
                      "radius": 10
                    },
                    {
                      "id": "bottom-empty",
                      "type": "block",
                      "content": {
                        "mod": "codenav",
                        "props": {
                          "view": "toolempty",
                          "side": "bottom"
                        }
                      },
                      "radius": 10
                    }
                  ]
                },
                {
                  "id": "island-bottom-bottom",
                  "type": "block",
                  "size": {
                    "px": 10
                  },
                  "min": 10,
                  "max": 10,
                  "background": "canvas",
                  "content": {
                    "mod": "codenav",
                    "props": {
                      "view": "islandbottom"
                    }
                  }
                }
              ],
              "min": 60,
              "background": "surface",
              "radius": 10
            }
          ],
          "min": 80,
          "gap": 6
        },
        {
          "id": "tool-right",
          "type": "column",
          "size": {
            "px": 300
          },
          "min": 120,
          "hidden": true,
          "background": "surface",
          "children": [
            {
              "id": "right-bar",
              "type": "block",
              "size": {
                "px": 32
              },
              "content": {
                "mod": "codenav",
                "props": {
                  "view": "toolheader",
                  "side": "right"
                }
              },
              "radius": 10
            },
            {
              "id": "right-views",
              "type": "stack",
              "active": "right-empty",
              "children": [
                {
                  "id": "right-empty",
                  "type": "block",
                  "content": {
                    "mod": "codenav",
                    "props": {
                      "view": "toolempty",
                      "side": "right"
                    }
                  },
                  "radius": 10
                }
              ]
            },
            {
              "id": "island-right-bottom",
              "type": "block",
              "size": {
                "px": 10
              },
              "min": 10,
              "max": 10,
              "background": "canvas",
              "content": {
                "mod": "codenav",
                "props": {
                  "view": "islandbottom"
                }
              }
            }
          ],
          "radius": 10
        },
        {
          "id": "stripe-right",
          "type": "block",
          "size": {
            "px": 40
          },
          "content": {
            "mod": "codenav",
            "props": {
              "view": "stripe",
              "side": "right"
            }
          },
          "min": 40,
          "max": 40,
          "background": "canvas"
        }
      ],
      "gap": 6,
      "padding": [
        0,
        0
      ]
    },
    {
      "id": "status-row",
      "type": "row",
      "size": {
        "px": 26
      },
      "children": [
        {
          "id": "crumbs",
          "type": "block",
          "content": {
            "mod": "codenav",
            "props": {
              "view": "crumbs"
            }
          }
        },
        {
          "id": "codenav-status",
          "type": "block",
          "size": {
            "px": 260
          },
          "content": {
            "mod": "codenav",
            "props": {
              "view": "status"
            }
          }
        }
      ],
      "background": "canvas",
      "padding": [
        0,
        0
      ]
    }
  ],
  "ui_font": ".AppleSystemUIFont",
  "gap": 6
}
