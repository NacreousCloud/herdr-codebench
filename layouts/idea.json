{
  "id": "root",
  "type": "column",
  "background": "chrome",
  "titlebar": "none",
  "traffic_lights": [
    12,
    13
  ],
  "theme": "idea",
  "terminal_padding": [
    10,
    8
  ],
  "terminal_menu": "codenav",
  "preview": "layouts/idea.svg",
  "children": [
    {
      "id": "main-toolbar",
      "type": "block",
      "size": {
        "px": 40
      },
      "window_drag": true,
      "content": {
        "mod": "codenav",
        "props": {
          "view": "toolbar"
        }
      }
    },
    {
      "id": "body",
      "type": "row",
      "divider": {
        "width": 1,
        "color": "raised"
      },
      "children": [
        {
          "id": "stripe",
          "type": "block",
          "size": {
            "px": 40
          },
          "content": {
            "mod": "codenav",
            "props": {
              "view": "stripe",
              "side": "left"
            }
          },
          "min": 40,
          "max": 40
        },
        {
          "id": "sidebar",
          "type": "column",
          "size": {
            "px": 300
          },
          "min": 160,
          "max": 640,
          "background": "chrome",
          "children": [
            {
              "id": "sidebar-views",
              "type": "stack",
              "active": "view-files",
              "children": [
                {
                  "id": "view-files",
                  "type": "block",
                  "content": {
                    "mod": "activity",
                    "props": {
                      "view": "files"
                    }
                  }
                },
                {
                  "id": "view-review",
                  "type": "block",
                  "content": {
                    "mod": "codenav",
                    "props": {
                      "view": "review",
                      "part": "side"
                    }
                  }
                },
                {
                  "id": "view-structure",
                  "type": "block",
                  "content": {
                    "mod": "codenav",
                    "props": {
                      "view": "structure"
                    }
                  }
                },
                {
                  "id": "view-search",
                  "type": "block",
                  "content": {
                    "mod": "activity",
                    "props": {
                      "view": "search"
                    }
                  }
                },
                {
                  "id": "left-empty",
                  "type": "block",
                  "content": {
                    "mod": "codenav",
                    "props": {
                      "view": "toolempty",
                      "side": "left"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "work-body",
          "type": "column",
          "divider": {
            "width": 1,
            "color": "raised"
          },
          "children": [
            {
              "id": "editor-area",
              "type": "column",
              "children": [
                {
                  "id": "editor-tabs",
                  "type": "block",
                  "content": {
                    "mod": "codenav",
                    "props": {
                      "view": "tabs"
                    }
                  },
                  "size": {
                    "px": 32
                  }
                },
                {
                  "id": "editor-stack",
                  "type": "stack",
                  "children": [
                    {
                      "id": "editor-code",
                      "type": "block",
                      "content": {
                        "mod": "codenav",
                        "props": {
                          "view": "code",
                          "slot": true
                        }
                      }
                    },
                    {
                      "id": "editor-text",
                      "type": "block",
                      "content": {
                        "mod": "activity",
                        "props": {
                          "view": "editor",
                          "slot": true
                        }
                      }
                    },
                    {
                      "id": "editor-review",
                      "type": "block",
                      "content": {
                        "mod": "codenav",
                        "props": {
                          "view": "review",
                          "part": "main"
                        }
                      }
                    }
                  ],
                  "active": "editor-code"
                }
              ],
              "size": {
                "weight": 3
              },
              "min": 140,
              "background": "background",
              "border": {
                "width": 1,
                "color": "border"
              },
              "radius": 10
            },
            {
              "id": "terminal-panel",
              "type": "column",
              "size": {
                "weight": 2
              },
              "children": [
                {
                  "id": "bottom-bar",
                  "type": "block",
                  "size": {
                    "px": 32
                  },
                  "content": {
                    "mod": "codenav",
                    "props": {
                      "view": "toolheader",
                      "side": "bottom"
                    }
                  }
                },
                {
                  "id": "bottom-stack",
                  "type": "stack",
                  "active": "bottom-terminal",
                  "children": [
                    {
                      "id": "bottom-terminal",
                      "type": "block",
                      "content": {
                        "tab": "active",
                        "pane": {
                          "background": "background",
                          "border": {
                            "width": 1,
                            "color": "border"
                          },
                          "focus": {
                            "width": 1,
                            "color": "accent"
                          },
                          "radius": 6,
                          "gap": 6
                        }
                      }
                    },
                    {
                      "id": "bottom-problems",
                      "type": "block",
                      "content": {
                        "mod": "codenav",
                        "props": {
                          "view": "problems"
                        }
                      }
                    },
                    {
                      "id": "bottom-empty",
                      "type": "block",
                      "content": {
                        "mod": "codenav",
                        "props": {
                          "view": "toolempty",
                          "side": "bottom"
                        }
                      }
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "id": "tool-right",
          "type": "column",
          "size": {
            "px": 300
          },
          "min": 160,
          "max": 640,
          "hidden": true,
          "background": "chrome",
          "children": [
            {
              "id": "right-views",
              "type": "stack",
              "active": "right-empty",
              "children": [
                {
                  "id": "right-empty",
                  "type": "block",
                  "content": {
                    "mod": "codenav",
                    "props": {
                      "view": "toolempty",
                      "side": "right"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "stripe-right",
          "type": "block",
          "size": {
            "px": 40
          },
          "content": {
            "mod": "codenav",
            "props": {
              "view": "stripe",
              "side": "right"
            }
          },
          "min": 40,
          "max": 40
        }
      ]
    },
    {
      "id": "status-row",
      "type": "row",
      "size": {
        "px": 26
      },
      "children": [
        {
          "id": "crumbs",
          "type": "block",
          "content": {
            "mod": "codenav",
            "props": {
              "view": "crumbs"
            }
          }
        },
        {
          "id": "codenav-status",
          "type": "block",
          "size": {
            "px": 260
          },
          "content": {
            "mod": "codenav",
            "props": {
              "view": "status"
            }
          }
        }
      ]
    }
  ]
}
